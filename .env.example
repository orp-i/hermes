# Container-level settings only. Model credentials, access codes, search keys and
# routing all live in config/hermes.yaml and are edited from the admin config page
# at /admin/config, so this file stays short.
#
# Generate a working copy with: ./scripts/bootstrap-env.sh

# Shared secret between the hermes web container and the runner that executes tool
# calls. Required: docker-compose refuses to start without it. Any long random string.
HERMES_RUNNER_TOKEN=

# Shared secret between the agent and the local OpenAI-compatible LLM router.
# Both sides are inside the compose network, so the default is usually fine.
HERMES_LLM_ROUTER_TOKEN=local-gateway

# Optional: build behind the Tsinghua TUNA mirrors. Set to 0 to use upstream
# pypi.org and deb.debian.org directly.
USE_TUNA_MIRROR=1

# Optional fallbacks, only read when the corresponding field on the config page is
# empty. Prefer the page.
# DEEPSEEK_API_KEY=
# TAVILY_API_KEY=
